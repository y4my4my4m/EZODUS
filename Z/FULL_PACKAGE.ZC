#define COMPONENT_COMPILER 1
#define COMPONENT_GRAPHICS 1
#define IMPORT_BUILTINS 1
#define INIT_EVERYTHING 1
#define FPTRS 1
//#define GEN_HEADERS 1
#define USE_DOLDOC 1
#define EZODUS 1
#include "HCRT_TOS.ZC"
#ifdef GEN_HEADERS
#include"GenHeaders.ZC";
CDoc *unfound=DocNew("unfound.DD");
#endif
static U0 BootstrapImportSymbol(U8 *name,U8 *ptr,U64 type) {
  CHash *find=HashFind(name,Fs->hash_table,-1);
  if (find && find->type&HTT_GLOBAL_VAR) {
    find(CHashGlobalVar*)->data_addr=ptr;
  } else if (find && find->type&HTT_FUN
             &&!(find(CHashFun*)->flags & 1<<Ff_INTERNAL)) {
    find(CHashFun*)->exe_addr=ptr;
    Btr(&find(CHashFun*)->flags,Cf_EXTERN);
  } else if (name[0]=='_' || !StrNCompare(name,"SYS",3) || !find) {
    find=CAlloc(sizeof(CHashExport));
    find->str=StrNew(name);
    find->type=HTT_EXPORT_SYS_SYM;
    find(CHashExport*)->val=ptr;
    HashAdd(find,Fs->hash_table);
#ifdef GEN_HEADERS
    DocPrint(unfound,"%s\n",name);
#endif
  } else {
#ifdef GEN_HEADERS
    DocPrint(unfound,"%s\n",name);
#endif
  }
}

asm { // embed boot headers to speedup boot
  _KERNELA_BIN::
  BINFILE "Kernel/KernelA.HH";
  DU8 0;
  _KERNELB_BIN::
  BINFILE "Kernel/KernelB.HH";
  DU8 0;
  _COMPILERA_BIN::
  BINFILE "Compiler/CompilerA.HH";
  DU8 0;
  _KERNELC_BIN::
  BINFILE "Kernel/KernelC.HH";
  DU8 0;
  _COMPILERB_BIN::
  BINFILE "Compiler/CompilerB.HH";
  DU8 0;
  _GR_HH_BIN::
  BINFILE "System/Gr/Gr.HH";
  DU8 0;
  _HEADERS_GEN_BIN:: // scripts/genheaders.py output: AOT public API headers
  BINFILE "HeadersGen.HH";
  DU8 0;
  _HEADERS_GEN_SYS_BIN::
  BINFILE "HeadersGenSys.HH";
  DU8 0;
};

#include "HomeSys.ZC"

U0 LoadImps() {
  try {
    ExePutS2("#define FPTRS;\n");
    ExePutS2(_KERNELA_BIN,"KernelA.HH");
    ExePutS2(_COMPILERA_BIN,"CompilerA.HH");
    ExePutS2(_GR_HH_BIN,"Gr.HH");
    ExePutS2(_HEADERS_GEN_BIN,"HeadersGen.HH");
    __BootstrapForeachSymbol(&BootstrapImportSymbol);
#ifdef GEN_HEADERS
    DocWrite(unfound);
    DocDel(unfound);
#endif
    // These need the sys syms the foreach creates (_UPPER asm labels; the
    // KernelC public API binds its extern addresses directly at parse).
    ExePutS2(_KERNELB_BIN,"KernelB.HH");
    ExePutS2(_KERNELC_BIN,"KernelC.HH");
    ExePutS2(_COMPILERB_BIN,"CompilerB.HH");
    ExePutS2(_HEADERS_GEN_SYS_BIN,"HeadersGenSys.HH");
    // KernelC re-declares extern vars already patched above; patch again so
    // the newest hash entries get their data_addr/exe_addr bound.
    __BootstrapForeachSymbol(&BootstrapImportSymbol);
  } catch {
    TOSPrint("BOOT ERROR:%c\n",Fs->except_ch);
    Fs->catch_except=TRUE;
  }
}

U0 HostSysGrInit()
{
  I64 i;
  text.font = sys_font_std;
  text.aux_font = sys_font_aux;
  text.aux_font[10] = text.font[10];
  text.aux_font[255] = text.font[255];
  for (i = 'Â³'; i < 'Ã›'; i++)
    text.aux_font[i] = text.font[i];
  text.aux_font['Â©'] = text.font['Â©'];
  text.border_chars[2] (I64) = 'ÄÍ³ºÚÉ¿»';
  text.border_chars[10](U32) = 'ÀÈÙ¼';
  text.cols = sys_framebuffer_width / FONT_WIDTH;
  text.rows = sys_framebuffer_height / FONT_HEIGHT;
  sys_framebuffer_pidth = sys_framebuffer_pitch / (sys_framebuffer_bpp / 8);
  text.screen_size = sys_framebuffer_pidth * sys_framebuffer_height;
  text.buffer_size = text.screen_size * 4;
  text.raw_screen = CAlloc(text.buffer_size);
  //32-bit direct-framebuffer apps (Demo/Graphics/32BitColor.ZC) write here;
  //blitted by DrawWindowUpdate32 while text.is_fb_busy.
  text.fb_alias = CAlloc(text.buffer_size);
}

U0 HostRunStartOS()
{//Stock ::/StartOS.ZC body â€” system AOT in HCRT; JIT ~/MakeHome at boot.
  CTask noreg *wmt;

  Option(OPTf_WARN_PAREN, ON);
  Option(OPTf_WARN_DUP_TYPES, ON);
  DocTermNew;
  WinVert(2, text.rows / 8);
  wmt = Spawn(&WinMgrTask, NULL, "Window Manager");
  if (!wmt || !TaskValidate(wmt))
    throw('WinMgr');
  sys_winmgr_task = wmt;
  Fs->win_inhibit = WIG_TASK_DEFAULT - WIF_SELF_BORDER - WIF_SELF_GRAB_SCROLL - WIF_SELF_CTRLS;
  LBts(&Fs->display_flags, DISPLAYf_CHILDREN_NOT_ON_TOP);
  LBts(&Fs->display_flags, DISPLAYf_SHOW);
  RegInit;
  LBts(&sys_run_level, RLf_REGISTRY);
  WallPaperInit;
  PaletteSetSlate;
  gr.fp_wall_paper = &WallPaper;
  Option(OPTf_WARN_PAREN, OFF);
  Option(OPTf_WARN_DUP_TYPES, OFF);
  LBts(&sys_run_level, RLf_HOME);
  while (!Bt(&sys_run_level, RLf_WINMGR))
    Yield;
  Refresh(1, FALSE);
  TermBttnNew;
  try GodInit; //EZODUS: stock runs this at HolySpirit.ZC include; seed AOT skips module-level statements.
  catch PutExcept(FALSE);
  try StartUpTasks;
  catch PutExcept(FALSE);
}

U0 HostKMainBoot()
{//Minimal KMain â€” host init then stock ::/StartOS.ZC (MakeHome â†’ HomeSys).
  sys_task = Fs;
  EzodusVfsInit;
  CInit;
  KeyDevInit;
  DrawWindowNew(GR_WIDTH, GR_HEIGHT);
  sys_framebuffer_width = GR_WIDTH;
  sys_framebuffer_height = GR_HEIGHT;
  sys_framebuffer_pitch = GR_WIDTH * 4;
  sys_framebuffer_bpp = 32;
  sys_framebuffer_pidth = GR_WIDTH;
  HostSysGrInit;
  EzodusMsInit;
  GrInit2;
  WinEzodusInit;
  GrEzodusInit;
  GrInit1;
  GrInit3;
  GrInit4;
  GrPaletteInit;
  DocInit;
  DocPutHooksInit;
  LoadDocDefines;
  LBts(&sys_run_level, RLf_DOC);
  Drive('Z');
  GodEzodusInit;
  MeshClipInit;
  MPIntsInit;
  Gs->executive_task = Fs;
  {
    I64 idx;
    for (idx = Gs->num + 1; idx < mp_count; ++idx)
      __SpawnCore(&CoreAPExecutiveTask);
    for (idx = Gs->num + 1; idx < mp_count; ++idx)
      while (!Bt(&mp_count_lock, idx))
        PAUSE;
  }
  LoadImps;
  //Stock GrGlobals.ZC does this at boot compile so JIT code sees the live
  //resolution; shadows the values baked into HeadersGen.HH.
  //(No HashPublic here: it needs an active compile context; DefineLoad
  //entries land in the task hash and are visible to all JIT compiles.)
  DefinePrint("GR_WIDTH", "%d", sys_framebuffer_width & ~7);
  DefinePrint("GR_HEIGHT", "%d", sys_framebuffer_height);
  DefinePrint("TEXT_ROWS", "%d", text.rows);
  DefinePrint("TEXT_COLS", "%d", text.cols);
  //Stock ~/MakeHome loads these; MakeBoot/MakeUtils/MapFileLoad are skipped
  //(already AOT in HCRT; no .MAP files on the host).
  try ExePrint("#include \"~/HomeLocalize\";\n");
  catch PutExcept(FALSE);
  try ExePrint("#include \"/System/Utils/MakeUtils\";\n");
  catch PutExcept(FALSE);
  try ExePrint("#include \"~/HomeWrappers\";\n");
  catch PutExcept(FALSE);
  try ExePrint("#include \"~/HomeKeyPlugIns\";\n");
  catch PutExcept(FALSE);
  Drive('Z');
  LBts(&sys_run_level, RLf_BLKDEV);
  LBts(&sys_run_level, RLf_COMPILER);
  PCSpkInit;
  Cd("/");
  HostRunStartOS;
  LBts(&sys_run_level, RLf_SYSTEM_SERVER);
  ServerTaskCont;
}

U0 _InitUI() {
  if (__IsCmdLine) {
    EzodusVfsInit;
    CInit;
    Drive('Z');
    LoadImps;
    try ExePrint("%s;\n", __CmdLineBootText);
    catch PutExcept(FALSE);
    Shutdown;
  }
  SetFs(sys_task);
  HostKMainBoot;
}
_InitUI;
#include "PUBLIC.ZC";;
