//Place this file in /Home and change
//anything you want.

U0 UserStartUp()
{//Run each time a user is spawned
	CTask noreg *t = Fs;

	if (!TaskValidate(t))
		return;
	DocTermNew;
	try Type("::/Doc/Start.DD");
	catch {}
	LBts(&t->display_flags, DISPLAYf_SHOW);
	WinToTop(t);
	WinZBufUpdate;
	try Dir("*", FALSE);
	catch {}
}

U0 ServerStartUp()
{//Run each time a server task is spawned.
	CTask noreg *t = Fs;

	if (!TaskValidate(t))
		return;
	DocTermNew;
	LBts(&t->display_flags, DISPLAYf_SHOW);
	WinToTop(t);
	WinZBufUpdate;
}

U0 StartUpTasks()
{
	CTask noreg *user;
	CTask noreg *st;

	user = User;
	if (!TaskValidate(user))
	{
		"StartUpTasks: User spawn failed\n";
		return;
	}
	if (sys_boot_src.u16[0] != BOOT_SRC_DVD)
		User;

	if (TaskValidate(user))
		WinToTop(user);
	WinTileVert;
	st = sys_task;
	WinVert(2, text.rows / 8, st);
	if (TaskValidate(st))
		TaskDerivedValsUpdate(st, FALSE);
	WinZBufUpdate;
	"Boot Time:%7.3fs\n", tS;
	try XTalkWait(user, "Cd; #include \"Once\";\n");
	catch {}
	Silent;
	try ACInit("::/Kernel/Kernel*.HH;::/Compiler/Compiler*.HH;::/System/*;::/Doc/*;::/Home/*");
	catch {}
	Silent(OFF);

	if (sys_boot_src.u16[0] != BOOT_SRC_RAM)
		try PopUp("ExeFile2(\"::/System/ZSplash.ZC\");");
	catch {}

	if (sys_os_version_nice)
		"\n%s\n\n", sys_os_version_nice;
}
