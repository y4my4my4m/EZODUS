//Place this file in /Home and change
//anything you want.
// EZODUS: Z/HomeSys.ZC — monolith boot (included from FULL_PACKAGE.ZC).

U0 UserStartUp()
{//Run each time a user is spawned
	if (!_ezodus_host)
		LoadDocDefines;
	DocTermNew;
	if (_ezodus_host)
	{
		Fs->border_attr = LTGRAY << 4 + PURPLE;
		PaletteSetSlate;
	}
	if (_ezodus_host)
		Type("::/Doc/StartHost.DD");
	else
		Type("::/Doc/Start.DD");
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
}

U0 ServerStartUp()
{//Run each time a server task is spawned.
	DocTermNew;
	LBts(&Fs->display_flags, DISPLAYf_SHOW);
	WinToTop;
	WinZBufUpdate;
}

U0 StartUpTasks()
{
	CTask *user;

	if (_ezodus_host)
	{
		user = User;
		WinTileVert;
		WinToTop(user);
		sys_focus_task = user;
		return;
	}

	user = User;
	if (sys_boot_src.u16[0] != BOOT_SRC_DVD)
		User;

	WinToTop(user);
	WinTileVert;
	sys_focus_task = user;
	"Boot Time:%7.3fs\n", tS;
	XTalk(user, "Cd(\"~/Home\"); #include \"Once\";\n");
	Silent;
	ACInit("::/Kernel/Kernel*.HH;::/Compiler/Compiler*.HH;::/System/*;::/Doc/*;::/Home/*");
	Silent(OFF);

	if (sys_boot_src.u16[0] != BOOT_SRC_RAM)
		PopUp("ExeFile2(\"::/System/ZSplash.ZC\");");
}
