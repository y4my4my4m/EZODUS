//EZODUS host networking: the ZealOS socket API bridged to host TCP sockets
//through the Dyad FFI. Ring-3 has no PCI NICs, port I/O or IRQs, so the
//hardware stack (Drivers/, Ethernet/ARP/IPV4/TCP) cannot run; programs that
//use the TCPSocket API (Telnet, Gopher, FTPClient, chat) work through this
//instead. UDP is not bridged.

#define AF_UNSPEC		0
#define AF_INET			2
#define AF_INET6		10
#define INADDR_ANY		0
#define SOCKET_STREAM	1
#define TCP_TIMEOUT		5000

class CIPV4Address
{
	U32 address;	// 'in Network Byte order' ... Big Endian
};

class CIPAddressStorage
{
	U8	padding[16];
};

class CSocketAddressIPV4
{
	U16				family;
	U16				port;		// Network Byte order
	CIPV4Address	address;
	U8				zeroes[8];
};

class CSocketAddressStorage
{
	U16 family;
	U8	padding[26];
};

class CAddressInfo
{
	I32						 flags;
	I32						 family;
	I32						 socket_type;
	I32						 protocol;
	I64						 address_length;
	CSocketAddressStorage	*address;
	U8						*canonical_name;
	CAddressInfo			*next;
};

class CIPV4Globals
{
	U32 local_ip;
} ipv4_globals;

class CTCPSocket
{
	U8			 state;
	U16			 domain;
	U64			 timeout;			// mS; 0 = non-blocking
	CDyadStream	*stream;
	U8			*buf;				// receive buffer, grows on demand
	I64			 read_pos, write_pos;
	Bool		 connected, closed;
	U16			 listen_port;
	CTCPSocket	*accept_head;		// listener: pending connections
	CTCPSocket	*accept_next;
};

CTask *ezodus_net_task;
I64 EZNET_EV_DATA, EZNET_EV_CLOSE, EZNET_EV_ERROR, EZNET_EV_DESTROY,
	EZNET_EV_CONNECT, EZNET_EV_ACCEPT;

U0 NetLog(U8 *format, ...)
{
	U8 *buf = StrPrintJoin(NULL, format, argc, argv);

	"%s\n", buf;
	Free(buf);
}

U0 NetErr(U8 *format, ...)
{
	U8 *buf = StrPrintJoin(NULL, format, argc, argv);

	"$FG,4$%s$FG$\n", buf;
	Free(buf);
}

U0 EzodusNetTaskEnd()
{
	DyadShutdown;
	Exit;
}

U0 EzodusNetTask(I64)
{
	DyadInit;
	ezodus_net_task = Fs;
	Fs->task_end_cb = &EzodusNetTaskEnd;
	while (TRUE)
	{
		DyadUpdate;
		Sleep(5);
	}
}

U0 EzodusNetInit()
{
	if (ezodus_net_task && TaskValidate(ezodus_net_task))
		return;
	EZNET_EV_DATA	 = _DyadGetCallbackMode("DYAD_EVENT_DATA");
	EZNET_EV_CLOSE	 = _DyadGetCallbackMode("DYAD_EVENT_CLOSE");
	EZNET_EV_ERROR	 = _DyadGetCallbackMode("DYAD_EVENT_ERROR");
	EZNET_EV_DESTROY = _DyadGetCallbackMode("DYAD_EVENT_DESTROY");
	EZNET_EV_CONNECT = _DyadGetCallbackMode("DYAD_EVENT_CONNECT");
	EZNET_EV_ACCEPT	 = _DyadGetCallbackMode("DYAD_EVENT_ACCEPT");
	Spawn(&EzodusNetTask, NULL, "HostNet");
	while (!ezodus_net_task)
		Yield;
}

U0 EzodusNetReadCB(CDyadStream *, U8 *data, I64 len, CTCPSocket *s)
{
	I64  used;
	U8	*old;

	if (!s->buf)
	{
		s->buf = MAlloc(len + 4096);
		s->read_pos = s->write_pos = 0;
	}
	else if (s->write_pos + len > MSize(s->buf))
	{
		used = s->write_pos - s->read_pos;
		old = s->buf;
		s->buf = MAlloc(used + len + 4096);
		MemCopy(s->buf, old + s->read_pos, used);
		Free(old);
		s->read_pos = 0;
		s->write_pos = used;
	}
	MemCopy(s->buf + s->write_pos, data, len);
	s->write_pos += len;
}

U0 EzodusNetCloseCB(CDyadStream *, CTCPSocket *s)
{
	s->closed = TRUE;
}

U0 EzodusNetConnectCB(CDyadStream *, CTCPSocket *s)
{
	s->connected = TRUE;
}

U0 EzodusNetStreamBind(CTCPSocket *s, CDyadStream *stream)
{
	s->stream = stream;
	DyadSetReadCallback(stream, EZNET_EV_DATA, &EzodusNetReadCB, s);
	DyadSetCloseCallback(stream, EZNET_EV_CLOSE, &EzodusNetCloseCB, s);
	DyadSetCloseCallback(stream, EZNET_EV_ERROR, &EzodusNetCloseCB, s);
	DyadSetCloseCallback(stream, EZNET_EV_DESTROY, &EzodusNetCloseCB, s);
}

U0 EzodusNetAcceptCB(CDyadStream *remote, CTCPSocket *listener)
{
	CTCPSocket *s = CAlloc(sizeof(CTCPSocket)), *tail;

	s->domain = AF_INET;
	s->timeout = TCP_TIMEOUT;
	s->connected = TRUE;
	EzodusNetStreamBind(s, remote);
	if (!listener->accept_head)
		listener->accept_head = s;
	else
	{
		tail = listener->accept_head;
		while (tail->accept_next)
			tail = tail->accept_next;
		tail->accept_next = s;
	}
}

public CTCPSocket *TCPSocket(U16 domain=AF_UNSPEC)
{
	CTCPSocket *s;

	if (domain == AF_INET6)
	{
		NetErr("TCP SOCKET: FIXME, IPV6 not implemented yet");
		return NULL;
	}
	EzodusNetInit;
	s = CAlloc(sizeof(CTCPSocket));
	s->domain = domain; // timeout stays 0: non-blocking, as stock

	return s;
}

I64 EzodusNetConnectWait(CTCPSocket *s)
{
	I64 mS = s->timeout, timeout;

	if (!mS)
		mS = TCP_TIMEOUT;
	timeout = counts.jiffies + mS * JIFFY_FREQ / 1000;

	while (!s->connected && !s->closed)
	{
		Sleep(1);
		if (counts.jiffies > timeout)
			break;
	}
	if (!s->connected)
	{
		NetErr("TCP SOCKET CONNECT: Failed.");
		return -1;
	}

	return 0;
}

public I64 TCPSocketConnect(CTCPSocket *tcp_socket, CSocketAddressStorage *address)
{
	CSocketAddressIPV4	*ipv4 = address;
	U32					 ip;
	U8					 host[16];

	if (!tcp_socket || address->family != AF_INET)
		return -1;
	EzodusNetInit;
	ip = ipv4->address.address; // host order, as the stock IPV4 layer uses it
	StrPrint(host, "%d.%d.%d.%d", ip >> 24 & 0xFF, ip >> 16 & 0xFF, ip >> 8 & 0xFF, ip & 0xFF);
	EzodusNetStreamBind(tcp_socket, DyadNewStream);
	DyadSetListenCallback(tcp_socket->stream, EZNET_EV_CONNECT, &EzodusNetConnectCB, tcp_socket);
	DyadConnect(tcp_socket->stream, host, EndianU16(ipv4->port));

	return EzodusNetConnectWait(tcp_socket);
}

public I64 TCPSocketClose(CTCPSocket *tcp_socket)
{
	if (!tcp_socket)
		return -1;
	if (tcp_socket->stream && !tcp_socket->closed)
		DyadEnd(tcp_socket->stream);
	Free(tcp_socket->buf);
	Free(tcp_socket);

	return 0;
}

public CTCPSocket *TCPConnectionCreate(U8 *hostname, U16 port)
{
	CTCPSocket *s = TCPSocket(AF_INET);

	if (!s)
		return NULL;
	EzodusNetStreamBind(s, DyadNewStream);
	DyadSetListenCallback(s->stream, EZNET_EV_CONNECT, &EzodusNetConnectCB, s);
	DyadConnect(s->stream, hostname, port);
	if (EzodusNetConnectWait(s) < 0)
	{
		TCPSocketClose(s);
		return NULL;
	}
	s->timeout = TCP_TIMEOUT * 3; // generous, as stock

	return s;
}

public I64 TCPSocketBind(CTCPSocket *tcp_socket, CSocketAddressStorage *address)
{
	CSocketAddressIPV4 *ipv4 = address;

	if (!tcp_socket || address->family != AF_INET)
		return -1;
	tcp_socket->listen_port = EndianU16(ipv4->port);

	return 0;
}

public I64 TCPSocketListen(CTCPSocket *tcp_socket, I64 backlog_size)
{
	no_warn backlog_size;
	EzodusNetInit;
	tcp_socket->stream = DyadNewStream;
	DyadSetListenCallback(tcp_socket->stream, EZNET_EV_ACCEPT, &EzodusNetAcceptCB, tcp_socket);
	if (DyadListen(tcp_socket->stream, tcp_socket->listen_port) < 0)
	{
		NetErr("TCP SOCKET LISTEN: Failed.");
		return -1;
	}

	return 0;
}

public CTCPSocket *TCPSocketAccept(CTCPSocket *tcp_socket)
{
	CTCPSocket *s;

	while (!tcp_socket->accept_head)
	{
		if (tcp_socket->closed)
			return NULL;
		Sleep(1);
	}
	s = tcp_socket->accept_head;
	tcp_socket->accept_head = s->accept_next;
	s->accept_next = NULL;

	return s;
}

public I64 TCPSocketReceive(CTCPSocket *tcp_socket, U8 *buffer, I64 length)
{
	I64 timeout = counts.jiffies + tcp_socket->timeout * JIFFY_FREQ / 1000, avail;

	while (!tcp_socket->closed && tcp_socket->read_pos == tcp_socket->write_pos)
	{
		Sleep(1);
		if (counts.jiffies > timeout)
			break;
	}
	if (tcp_socket->read_pos == tcp_socket->write_pos)
	{
		if (tcp_socket->closed)
			return 0;
		if (tcp_socket->timeout)
			NetErr("TCP SOCKET RECEIVE: Timed out.");

		return -1;
	}
	avail = tcp_socket->write_pos - tcp_socket->read_pos;
	if (avail > length)
		avail = length;
	MemCopy(buffer, tcp_socket->buf + tcp_socket->read_pos, avail);
	tcp_socket->read_pos += avail;

	return avail;
}

public I64 TCPSocketReceiveLine(CTCPSocket *tcp_socket, U8 *buffer, I64 size)
{
	I64 received = 0;

	while (received + 1 < size)
	{
		if (TCPSocketReceive(tcp_socket, buffer + received, 1) <= 0)
		{
			NetErr("TCP SOCKET RECEIVE LINE: Failed at TCPSocketReceive.");
			return -1;
		}
		if (buffer[received] == '\n')
			break;
		else if (buffer[received] != '\r')
			received++;
	}
	buffer[received] = 0;

	return received;
}

public I64 TCPSocketSend(CTCPSocket *tcp_socket, U8 *buffer, I64 length)
{
	if (!tcp_socket->stream || tcp_socket->closed)
	{
		NetErr("TCP SOCKET SEND: Socket not open.");
		return -1;
	}
	DyadWrite(tcp_socket->stream, buffer, length);

	return length;
}

public I64 TCPSocketSendAll(CTCPSocket *tcp_socket, U8 *buffer, I64 length)
{
	return TCPSocketSend(tcp_socket, buffer, length);
}

public I64 TCPSocketSendString(CTCPSocket *tcp_socket, U8 *string)
{
	return TCPSocketSend(tcp_socket, string, StrLen(string));
}

public I64 IPV4AddressParse(U8 *string, U32 *destination)
{//Dotted quad only; returns host-order value like the stock IPV4 layer.
	I64 part = 0, val = 0, seen = 0;
	U32 out = 0;
	U8 *p = string;

	while (*p)
	{
		if ('0' <= *p <= '9')
		{
			val = val * 10 + *p - '0';
			if (val > 255)
				return 0;
			seen = 1;
		}
		else if (*p == '.')
		{
			if (!seen || part == 3)
				return 0;
			out = out << 8 + val;
			val = 0;
			seen = 0;
			part++;
		}
		else
			return 0;
		p++;
	}
	if (!seen || part != 3)
		return 0;
	*destination = out << 8 + val;

	return 1;
}

public U8 *NetworkToPresentation(I64 address_family, CIPAddressStorage *source)
{
	static U8 buf[16];
	U8 *p = source;

	if (address_family != AF_INET)
		return "?";
	StrPrint(buf, "%d.%d.%d.%d", p[0], p[1], p[2], p[3]);

	return buf;
}

public I64 DNSAddressInfoGet(U8 *hostname, U8 *service, CAddressInfo **result)
{
	U32					 ip;
	CAddressInfo		*info;
	CSocketAddressIPV4	*addr;

	no_warn service;
	ip = HostDNSResolve(hostname); // network byte order
	if (!ip)
	{
		NetErr("DNS: Host resolver failed for '%s'.", hostname);
		return -1;
	}
	info = CAlloc(sizeof(CAddressInfo));
	addr = CAlloc(sizeof(CSocketAddressStorage));
	addr->family = AF_INET;
	addr->address.address = ip;
	info->family = AF_INET;
	info->socket_type = SOCKET_STREAM;
	info->address_length = sizeof(CSocketAddressIPV4);
	info->address = addr;
	info->canonical_name = StrNew(hostname);
	*result = info;

	return 0;
}

public U0 AddressInfoFree(CAddressInfo *info)
{
	CAddressInfo *next;

	while (info)
	{
		next = info->next;
		Free(info->address);
		Free(info->canonical_name);
		Free(info);
		info = next;
	}
}

public U0 NetConfigure(Bool prompt=FALSE)
{//Host handles DHCP/ARP/routing; nothing to configure in ring-3.
	no_warn prompt;
	EzodusNetInit;
	ipv4_globals.local_ip = 0x0100007F; // 127.0.0.1, network order
	"Host networking: TCP is bridged to host sockets (Dyad).\n";
}

public U0 NetRep()
{
	"\nEzodus host networking\n"
	"  TCP client/server: bridged to host sockets\n"
	"  DNS:               host resolver\n"
	"  UDP/ICMP/raw:      not available in ring-3\n\n";
}

//UDP is datagram-based; Dyad only does TCP streams.
#define EZNET_NO_UDP "UDP is not available under Ezodus host networking."

class CUDPSocket
{
	U8 state;
};

public CUDPSocket *UDPSocket(U16 domain=AF_UNSPEC)
{
	no_warn domain;
	NetErr(EZNET_NO_UDP);
	return NULL;
}

public I64 UDPSocketBind(CUDPSocket *udp_socket, CSocketAddressStorage *address_source)
{
	no_warn udp_socket, address_source;
	return -1;
}

public I64 UDPSocketClose(CUDPSocket *udp_socket)
{
	no_warn udp_socket;
	return -1;
}

public I64 UDPSocketReceiveFrom(CUDPSocket *udp_socket, U8 *buffer, I64 len, CSocketAddressStorage *address_out)
{
	no_warn udp_socket, buffer, len, address_out;
	return -1;
}

public I64 UDPSocketSendTo(CUDPSocket *udp_socket, U8 *buffer, I64 len, CSocketAddressStorage *destination_addr)
{
	no_warn udp_socket, buffer, len, destination_addr;
	return -1;
}
