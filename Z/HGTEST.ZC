U8 *buf = FileRead("HGPART.HH");
if (!buf) TOSPrint("no file\n");
else {
  try ExePutS2(buf, "HGPART.HH");
  catch { TOSPrint("EXCEPT\n"); Fs->catch_except=TRUE; }
  TOSPrint("RESULT ez1=%x ez2=%x ez3=%x\n",
    HashFind("EzBisect1",Fs->hash_table,-1),
    HashFind("EzBisect2",Fs->hash_table,-1),
    HashFind("EzBisect3",Fs->hash_table,-1));
}
Shutdown;
