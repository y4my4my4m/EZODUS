#help_index "Define;Char/Define"

U0 LoadDocDefines()
{
	CZXE *zxe;
	U8 *os_name = sys_os_version_str;

	if (!os_name)
		os_name = "Ezodus ZealOS";
	TOSPrint("LDD:1\n");
	DefinePrint("DD_OS_NAME_VERSION", os_name);
	TOSPrint("LDD:2\n");
	// EZODUS: skip float DefinePrint — host StrPrintJoin %f path SIGSEGV during boot.
	DefinePrint("DD_ZEALOS_AGE", "0.0");
	TOSPrint("LDD:3\n");
	DefinePrint("DD_TEMPLEOS_AGE", "0.0");
	TOSPrint("LDD:4\n");
	// DocBorderNew LEN=STR_LEN-1 and $$BG+H,LTRED$$ need these for LexExpressionI64.
	DefinePrint("STR_LEN", "144");
	DefinePrint("BLACK", "0");
	DefinePrint("BLUE", "1");
	DefinePrint("GREEN", "2");
	DefinePrint("CYAN", "3");
	DefinePrint("RED", "4");
	DefinePrint("PURPLE", "5");
	DefinePrint("BROWN", "6");
	DefinePrint("LTGRAY", "7");
	DefinePrint("DKGRAY", "8");
	DefinePrint("LTBLUE", "9");
	DefinePrint("LTGREEN", "10");
	DefinePrint("LTCYAN", "11");
	DefinePrint("LTRED", "12");
	DefinePrint("LTPURPLE", "13");
	DefinePrint("YELLOW", "14");
	DefinePrint("WHITE", "15");
	DefinePrint("GR_WIDTH", "640");
	DefinePrint("GR_HEIGHT", "480");
	DefinePrint("FONT_WIDTH", "8");
	DefinePrint("FONT_HEIGHT", "8");
	DefinePrint("TEXT_COLS", "80");
	DefinePrint("TEXT_ROWS", "60");
	// EdPullDown.DD menu keys — LexExpressionI64 in MenuFile needs these in hash.
	DefinePrint("CH_CTRLA", "0x01");
	DefinePrint("CH_CTRLB", "0x02");
	DefinePrint("CH_CTRLC", "0x03");
	DefinePrint("CH_CTRLD", "0x04");
	DefinePrint("CH_CTRLE", "0x05");
	DefinePrint("CH_CTRLF", "0x06");
	DefinePrint("CH_CTRLG", "0x07");
	DefinePrint("CH_CTRLH", "0x08");
	DefinePrint("CH_CTRLI", "0x09");
	DefinePrint("CH_CTRLJ", "0x0A");
	DefinePrint("CH_CTRLK", "0x0B");
	DefinePrint("CH_CTRLL", "0x0C");
	DefinePrint("CH_CTRLM", "0x0D");
	DefinePrint("CH_CTRLO", "0x0F");
	DefinePrint("CH_CTRLP", "0x10");
	DefinePrint("CH_CTRLQ", "0x11");
	DefinePrint("CH_CTRLR", "0x12");
	DefinePrint("CH_CTRLS", "0x13");
	DefinePrint("CH_CTRLT", "0x14");
	DefinePrint("CH_CTRLU", "0x15");
	DefinePrint("CH_CTRLV", "0x16");
	DefinePrint("CH_CTRLW", "0x17");
	DefinePrint("CH_CTRLX", "0x18");
	DefinePrint("CH_CTRLY", "0x19");
	DefinePrint("CH_CTRLZ", "0x1A");
	DefinePrint("CH_ESC", "0x1B");
	DefinePrint("CH_SHIFT_ESC", "0x1C");

	if (mem_boot_base && CheckPtr(mem_boot_base(U8 *)))
	{
		zxe = mem_boot_base - sizeof(CZXE);
		DefinePrint("DD_KERNEL", "%08X", zxe);
		zxe(I64) += zxe->file_size - 1;
		DefinePrint("DD_KERNEL_END", "%08X", zxe);
	}
	else
	{
		DefinePrint("DD_KERNEL", "%08X", 0);
		DefinePrint("DD_KERNEL_END", "%08X", 0);
	}

	//$LK,"DD_BOOT_HIGH_LOC_DVD",A="FF:::/System/Boot/BootDVD.ZC,DD_BOOT_HIGH_LOC_DVD"$

	// EZODUS: stock used $TR/$ID DolDoc cmds here; inside a HolyC function they LexErr on host.
	DefinePrint("DD_ZEALOS_LOC", "99,737");
	DefinePrint("DD_MP_VECT", "%08X", 0);
	DefinePrint("DD_MP_VECT_END", "%08X", 0);

	DefinePrint("DD_SYS_FIXED_AREA_BASE", "%08X", SYS_FIXED_AREA);
	DefinePrint("DD_SYS_FIXED_AREA_END", "%08X", SYS_FIXED_AREA + sizeof(CSysFixedArea) - 1);
	DefinePrint("DD_MEM_HEAP_BASE", "%08X", mem_heap_base);
	DefinePrint("DD_MEM_HEAP_LIMIT", "%08X", mem_heap_limit);
	DefinePrint("DD_MEM_MIN_MEG", "%dMeg", MEM_MIN_MEG);
	DefinePrint("DD_UNCACHED_ALIAS", "%010X", 0);
	DefinePrint("DD_PHYSICAL_SPACE_END", "%010X", 0);
	DefinePrint("DD_MAPPED_SPACE_END", "%010X", 0);
	DefinePrint("DD_JIFFY_HZ", "%dHz", JIFFY_FREQ);
}

// EZODUS: runs from _InitUI after CInit.
