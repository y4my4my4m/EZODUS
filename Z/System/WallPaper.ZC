#help_index "Windows"

class CWallPaperGlobals
{
	I64 	last_calc_idle_count, last_swap_counter[MP_PROCESSORS_NUM];
	F64 	last_calc_idle_delta_time;
	U8		top_line[STR_LEN];
	I64		res_str_size;
	U8		host_ch;
	U8		bootm_ch;
	U8		bootl_ch;
	U8		boots_ch;
};

CWallPaperGlobals *wall;

U0 WallPaperEzodusInit()
{//EZODUS: defer module-level CAlloc -- heap/Fs not ready at IET.
	wall = CAlloc(sizeof(CWallPaperGlobals));
	wall->last_calc_idle_delta_time = 1.0;
}

class CTaskWallPaperData
{
	I64 	alloced_u8s, used_u8s;
	U8		caller_stack[4096 - $$];
};

U0 WallPaper(CTask *_task)
{
	I64					 i, j, k, l = TEXT_ROWS - 1;
	CTask noreg			*wm;
	CTask noreg			*tt;
	CTaskWallPaperData	*wpd;
	CHashTable			*old_hash;
	CCPU				*c;
	CDateStruct			 ds;
	U8					*st;

	if (!wall)
		return;
	if (!winmgr.t)
		return;
	if (!TaskValidate(_task))
		return;
	wm = _task;

	old_hash = wm->hash_table;
	wm->text_attr = DKGRAY << 4 + WHITE;
	if (sys_data_bp && sys_code_bp)
	{
		TextPrint(wm, 0, l--, DKGRAY << 4 + YELLOW,
					"%010X/%010X %010X/%010X%12td%12td%12td",
					sys_data_bp->used_u8s, sys_data_bp->alloced_u8s,
					sys_code_bp->used_u8s, sys_code_bp->alloced_u8s,
					cmp.compiled_lines, blkdev.read_count, blkdev.write_count);

		TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE,
					"______Data_Heap______ ______Code_Heap______ "
					"___Lines___ ___Reads___ __Writes___");
	}
	else if (sys_code_bp)
	{
		TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE,
					"%010X/%010X%12td%12td%12td",
					sys_code_bp->used_u8s, sys_code_bp->alloced_u8s,
					cmp.compiled_lines, blkdev.read_count, blkdev.write_count);

		TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE,
					"____CodeData_Heap____ "
					"___Lines___ ___Reads___ ___Writes__");
	}
	else // EZODUS: host pthread has no ring-0 code block pool (sys_code_bp==NULL).
	{
		TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE,
					"%12td%12td%12td",
					cmp.compiled_lines, blkdev.read_count, blkdev.write_count);

		TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE,
					"___Lines___ ___Reads___ ___Writes__");
	}
	TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE, "ProgressBars:%016X %016X %016X %016X",
				progress1, progress2, progress3, progress4);

	for (i = 0; i < mp_count; i++)
	{
		c = &cpu_structs[i];
		if (winmgr.t->calc_idle_count != wall->last_calc_idle_count)
		{
			wall->last_calc_idle_delta_time = winmgr.t->calc_idle_delta_time;
			wall->last_swap_counter[i] = winmgr.t->last_swap_counter[i];
			winmgr.t->last_swap_counter[i] = c->swap_counter;
		}

		tt = c->executive_task;
		do
		{
			if (!TaskValidate(tt))
				break;
			wpd = &tt->wallpaper_data;
			if (!(winmgr.updates & 5))
			{
				if (c == Gs)
					wm->hash_table = tt->hash_table;
				else //precaution
					wm->hash_table = old_hash;

				// EZODUS: TaskCaller/FunSegFind NULL on host pthread tasks.
				if (sys_code_bp && mem_boot_base)
				{
					StrPrint(wpd->caller_stack, "    %p ", TaskCaller(tt, 0));
					for (j = 1; j < 16; j++)
					{
						if ((k = TaskCaller(tt, j)) > 0)
							CatPrint(wpd->caller_stack, "? %p ", k);
					}
				}
				else
					StrCopy(wpd->caller_stack, tt->task_name);
			}
			TextPrint(wm, 0, l--, DKGRAY << 4 + YELLOW, wpd->caller_stack);
			j = UnusedStack(tt);
			if (j < 0)
				Panic("Stack Overflow", tt);
			if (!(winmgr.updates & 15))
			{
				wpd->alloced_u8s = TaskMemAlloced(tt);
				wpd->used_u8s 	 = TaskMemUsed(tt);
			}
			TextPrint(wm, 0, l--, DKGRAY << 4 + BLACK,
						"  %-18s #%08X %010X %010X/%010X %04X:%02tX:%08X",
						tt->task_name, tt, j, wpd->used_u8s, wpd->alloced_u8s,
						tt->task_flags, tt->display_flags, tt->win_inhibit);
			if (!TaskValidate(tt))
				break;
			tt = tt->next_task;
		}
		while (tt != c->executive_task);

		TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE, "CPU%02X %2tf%% ContextSwaps/s:%9,d", i,
					100.0 * (1.0 - c->idle_factor), ToI64((winmgr.t->last_swap_counter[i]
					- wall->last_swap_counter[i]) / wall->last_calc_idle_delta_time));
	}
	TextPrint(wm, 0, l--, DKGRAY << 4 + WHITE,
				"  ___Description____ #__Task__ UnusedStack _UsedMem_/_AllocMem_ ______Flags_____");

	if (!(winmgr.updates & 15) || !*wall->top_line)
	{
		Date2Struct(&ds, Now);
		i = 0;
		if (sys_code_bp)
			i += sys_code_bp->alloced_u8s - sys_code_bp->used_u8s;
		if (sys_data_bp)
			i += sys_data_bp->alloced_u8s - sys_data_bp->used_u8s;
	// EZODUS: skip ST_DAYS_OF_WEEK define lookup — crashes Print on WinMgr task.
	{
		U8 *dow;

		switch (ds.day_of_week % 7)
		{
			case 0: dow = "Sun"; break;
			case 1: dow = "Mon"; break;
			case 2: dow = "Tue"; break;
			case 3: dow = "Wed"; break;
			case 4: dow = "Thu"; break;
			case 5: dow = "Fri"; break;
			default: dow = "Sat"; break;
		}
		StrPrint(wall->top_line,
					" %3ts %02d/%02d/%02d %02d:%02d:%02d FPS:%2tf RAM:%010X CPU:",
					dow, ds.mon, ds.day_of_mon, ds.year % 100,
					ds.hour, ds.min, ds.sec, winmgr.fps, i);
	}
	}
	TextPrint(wm, 0, 0, DKGRAY << 4 + WHITE, wall->top_line);

	if (screencast.record)
		TextPrint(wm, 44 -4, 0, DKGRAY << 4 + RED, "*");

	j = StrLen(wall->top_line);
	k = 0;
	for (i = 0; i < mp_count; i++)
	{
		c = &cpu_structs[i];
		if (i & 1)
			TextPrint(wm, j + i * 2, 0, DKGRAY << 4 + WHITE, "%2tf", 100.0 * (1.0 - c->idle_factor));
		else
			TextPrint(wm, j + i * 2, 0, DKGRAY << 4 + YELLOW, "%2tf", 100.0 * (1.0 - c->idle_factor));
		k += 2;
	}
	j += k + 1;
	TextPrint(wm, j, 0, DKGRAY << 4 + WHITE, "BOOT:");
	j += 5;
	TextPrint(wm, j, 0, DKGRAY << 4 + LTGREEN, "%c", wall->bootm_ch);
	j += 1;
	TextPrint(wm, j, 0, DKGRAY << 4 + LTGREEN, "%c", wall->bootl_ch);
	j += 1;
	TextPrint(wm, j, 0, DKGRAY << 4 + LTGREEN, "%c", wall->boots_ch);
	j += 1;
	TextPrint(wm, j, 0, DKGRAY << 4 + LTGREEN, "%c", wall->host_ch);
	j += 2;
	st = "RES:";
	TextPrint(wm, j, 0, DKGRAY << 4 + WHITE, st);
	j += 4;
	TextPrint(wm, j, 0, DKGRAY << 4 + LTGREEN, "%dx%d", sys_framebuffer_width, sys_framebuffer_height);
	j += wall->res_str_size;
	st = "OS:";
	TextPrint(wm, j, 0, DKGRAY << 4 + WHITE, st);
	j += 3;
	TextPrint(wm, j, 0, DKGRAY << 4 + LTGREEN, "V%.02f.%d", sys_os_version, sys_os_version_sub);

	st = ScanCode2KeyName(kbd.last_down_scan_code);
	if (st)
	{
		TextPrint(wm, TEXT_COLS - 25, 0, DKGRAY << 4 + YELLOW, "%25ts", st);
		Free(st);
	}

	wm->hash_table = old_hash;
	wall->last_calc_idle_count = winmgr.t->calc_idle_count;
}

U0 DrawTermBttn(CDC *dc, CCtrl *c)
{
	I64 x = c->left / FONT_WIDTH;
	I64 y = c->top / FONT_HEIGHT;
	CTask *wmt = c->win_task;

	if (!wmt)
		return;
	if (Blink)
		TextPrint(wmt, x, y, DKGRAY << 4 + YELLOW, "[Term]");
	else
		TextPrint(wmt, x, y, DKGRAY << 4 + LTGRAY, "[Term]");
}

U0 LeftClickTermBttn(CCtrl *, I64, I64, Bool down)
{
	if (down)
		User;
}

public CCtrl *TermBttnNew()
{
	I64		 pw, ph;
	CTask noreg *wmt = sys_winmgr_task;
	CCtrl	*c;

	if (!wmt || !TaskValidate(wmt))
		return NULL;

	c = SysCAlloc(sizeof(CCtrl));
	c->win_task		= wmt;
	c->flags		= CTRLF_SHOW;
	c->type			= CTRLT_GENERIC;
	c->draw_it		= &DrawTermBttn;
	c->left_click	= &LeftClickTermBttn;

	pw = wmt->pix_width;
	ph = wmt->pix_height;
	if (pw <= 0)
		pw = TEXT_COLS * FONT_WIDTH;
	if (ph <= 0)
		ph = TEXT_ROWS * FONT_HEIGHT;

	c->left		= pw - 6 * FONT_WIDTH;
	c->right	= c->left + 6 * FONT_WIDTH - 1;
	c->top		= ph - FONT_HEIGHT;
	c->bottom	= c->top + FONT_HEIGHT - 1;

	QueueInsert(c, wmt->last_ctrl);
	WinDerivedValsUpdate(wmt);

	return c;
}

U0 WallPaperInit()
{
	if (!wall)
		WallPaperEzodusInit;

	// Defer wallpaper callback until after first WinMgr Refresh (see FULL_PACKAGE).

	if (!_ezodus_host)
	{
		CSMBIOSSystemInfo	*sys_info = SMBIOSStructGet(SMBIOSt_SYSTEM);
		U8					*company = "None";

		if (sys_info)
			company = SMBIOSStr(sys_info, sys_info->manufacturer);

		if (!StrCompare(company, "VMware, Inc."))
			wall->host_ch = 'W'; // vmWare
		else if (!StrCompare(company, "innotek GmbH"))
			wall->host_ch = 'V'; // Virtualbox
		else if (!StrCompare(company, "QEMU"))
			wall->host_ch = 'Q'; // Qemu
		else
			wall->host_ch = '?'; // Bare-Metal / Unknown VM
	}
	else
		wall->host_ch = '?';

	if (sys_is_uefi_booted)
		wall->bootm_ch = 'U'; // UEFI
	else
		wall->bootm_ch = 'B'; // BIOS

	switch (sys_bootloader_id)
	{
		case BL_ZEAL:
			wall->bootl_ch = 'Z'; // PublicDomain Bootloader
			break;
		case BL_LIMINE:
			wall->bootl_ch = 'L'; // Limine Bootloader
			break;
		default:
			wall->bootl_ch = '!'; // Unknown Bootloader
	}

	switch (sys_boot_src.u8[0])
	{
		case BOOT_SRC_ROM:
			wall->boots_ch = 'O'; // ROM
			break;
		case BOOT_SRC_RAM:
			wall->boots_ch = 'R'; // RAM
			break;
		case BOOT_SRC_HARDDRIVE:
			wall->boots_ch = 'H'; // HDD
			break;
		case BOOT_SRC_DVD:
			wall->boots_ch = 'D'; // DVD
			break;
		default:
			wall->boots_ch = 'X'; // Unknown/missing case
	}

	// # of chars in resolution string in top bar
	wall->res_str_size = ToI64(2 + Floor(1 + Log10(sys_framebuffer_width)) + Floor(1 + Log10(sys_framebuffer_height)));
}
