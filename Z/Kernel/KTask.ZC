static I64 tq_lock = FALSE;

extern U0 GrUpdateScreen();
extern U0 UserStartUp();
extern U0 ServerStartUp();
extern U0 EzodusCurDirValidate(CTask *task=NULL);

U0 TaskQueueIns(CTask *task, CTask *pred = NULL)
{//Insert task in scheduler running task queue.
	CTask *last;

	if (!pred)
		pred = Fs;
	while (LBts(&tq_lock, 0))
		PAUSE;
	last = pred->last_task;
	last->next_task = pred->last_task = task;
	task->last_task = last;
	task->next_task = pred;
	LBtr(&tq_lock, 0);
}

U0 TaskQueueRemove(CTask *task)
{//Remove task from scheduler running task queue.
	CTask *next, *last;

	while (LBts(&tq_lock, 0))
		PAUSE;
	next = task->next_task;
	last = task->last_task;
	last->next_task = next;
	next->last_task = last;
	LBtr(&tq_lock, 0);
}

U0 TaskQueueInsChild(CTask *task)
{
	CTask *last, *pred;

	while (LBts(&tq_lock, 0))
		PAUSE;
	pred = task->parent_task->last_child_task;
	last = pred->last_sibling_task;
	last->next_sibling_task = pred->last_sibling_task = task;
	task->last_sibling_task = last;
	task->next_sibling_task = pred;
	LBtr(&tq_lock, 0);
}

U0 Exit()
{//Terminate own task.
	if (Fs == sys_focus_task && IsDebugMode)
	{
		LBts(&Fs->task_flags, TASKf_KILL_AFTER_DEBUG);
		G;
	}
	else
	{
		if (!Gs->num && !IsDebugMode)
			SingleUser(OFF);

		// EZODUS: ring-0 TaskEndNow path replaced by scheduler yield.
		LBts(&Fs->task_flags, TASKf_KILL_TASK);
		Yield;
	}
}

Bool TaskValidate(CTask *task)
{//return TRUE if task looks valid.
	if (!task || task->addr != task || task->task_signature != TASK_SIGNATURE_VAL)
		return FALSE;
	// EZODUS: host heap pointers often >I32_MAX; ring-0 only had low32 addrs.
	if (mem_boot_base && !(0 < task(I64) <= I32_MAX))
		return FALSE;
	return TRUE;
}

I64 BirthWait(CTask **_task, I64 task_num=-1)
{//Wait for task valid and not task_num.
	while (!TaskValidate(*_task) || (*_task)->task_num == task_num)
		Yield;

	return (*_task)->task_num;
}

U0 DeathWait(CTask **_task, Bool send_exit=FALSE)
{//Wait for task death.
	if (send_exit && TaskValidate(*_task))
	{
		TaskWait(*_task, TRUE);
		XTalk(*_task, "Exit;\n");
	}
	while (TaskValidate(*_task))
		Yield;
}

Bool Kill(CTask *task, Bool wait=TRUE, Bool just_break=FALSE)
{//Terminate other task.
	I64 i;

	if (TaskValidate(task))
	{
		if (just_break)
		{
			if (task != Fs)
				Break;
			else
			{//TODO wait
				sys_focus_task = task;
				LBts(sys_ctrl_alt_flags, CTRL_ALT_C);
				return TRUE;
			}
		}
		else
		{
			if (task != sys_winmgr_task)
			{
				for (i = 0; i < mp_count; i++)
					if (task == cpu_structs[i].executive_task)
						return FALSE;
				LBts(&task->task_flags, TASKf_KILL_TASK);
				if (wait)
				{
					do Yield;
					while (TaskValidate(task) && Bt(&task->task_flags, TASKf_KILL_TASK));
				}
				return TRUE;
			}
		}
	}

	return FALSE;
}

Bool Suspend(CTask *task=NULL, Bool state=TRUE)
{//Tell scheduler to skip task.
	Bool res;

	if (!task)
		task = Fs;

	PUSHFD
	CLI
	if (TaskValidate(task))
		res = LBEqual(&task->task_flags, TASKf_SUSPENDED, state);
	else
		res = FALSE;
	POPFD

	return res;
}

Bool IsSuspended(CTask *task=NULL)
{//You might use this in a DrawIt() or Animatetask().
	if (!task)
		task = Fs;

	if (TaskValidate(task))
		return Bt(&task->task_flags, TASKf_SUSPENDED);
	else
		return FALSE;
}

CTaskStack *TaskStackNew(I64 stack_size, CTask *task)
{
	CTaskStack *tmps = MAlloc(stack_size + offset(CTaskStack.stack_base), task);

	tmps->next_stack	= NULL;
	tmps->stack_ptr		= NULL;
	// EZODUS: MSize() wrong on fresh host heap pages — use requested size.
	tmps->stack_size	= stack_size;

	return tmps;
}

#exe {Option(OPTf_NO_REG_VAR, ON);};
argpop I64 CallStackGrow(I64 stack_size_threshold, I64 stack_size, /*argpop*/I64 (*fp_addr)(...), ...)
{//Grow stack in call with any fixed num of args.
//See $LK,"::/Demo/StackGrow.ZC"$.
	CTaskStack	*tmps, *tmps2, **_stack;
	I64			 res, *rsp, *rsp2, *old_stack;

	if (UnusedStack >= stack_size_threshold)
	{

		asm {
			LEAVE
			POP 			RAX 	//return addr
			ADD 			RSP, 16	//pop threshold, stack_size
			POP 			RBX 	// *f
			ADD 			RSP, 8 	//pop ARGC
			PUSH			RAX
			JMP 			RBX 	//CALL fp_addr()
		};

	}
	else
	{

		tmps2 = TaskStackNew(stack_size, Fs);
		tmps2->next_stack = tmps = Fs->stack;
		rsp2 = (&tmps2->stack_base)(U8 *) + tmps2->stack_size;
		old_stack = rsp = &argv[argc];
		while (argc-- > 0)
			*--rsp2 = *--rsp;
		_stack = &Fs->stack;
		tmps->stack_ptr = rsp = RSPGet;
		asm {
			IMPORT			_FREE;	//We are in a function, not at global scope.
//The compiler treats these in isolation.

			PUSHFD
			POP 			RDX 			//flags
			CLI
			MOV 			RBX, U64 &tmps2[RBP]
			MOV 			RAX, &_stack[RBP]
			MOV 			U64 [RAX], RBX 	//Fs->stack=tmps2
			MOV 			RSP, U64 &rsp2[RBP]
			PUSH			RDX
			POPFD

			CALL			U64 &fp_addr[RBP]
			MOV 			U64 &res[RBP], RAX

			PUSHFD
			POP 			RDX 			//flags
			CLI
			MOV 			RBX, U64 &tmps[RBP]
			MOV 			RAX, &_stack[RBP]
			MOV 			U64 [RAX], RBX 	//Fs->stack=tmps
			MOV 			RSP, U64 &rsp[RBP]
			PUSH			RDX
			POPFD

			PUSH			U64 &tmps2[RBP]
			CALL			_FREE

			MOV 			RDX, U64 &old_stack[RBP]
			MOV 			RBX, U64 8[RBP]
			MOV 			RAX, U64 &res[RBP]
			MOV 			RBP, U64 [RBP]
			MOV 			RSP, RDX
			JMP 			RBX 			//return
		};
	}

	return 0; //dummy to get rid of warning
}
;
#exe {Option(OPTf_NO_REG_VAR, OFF);};

I64 TaskInit(CTask *task, I64 stack_size)
{//Returns Fs of task
	CTask noreg *t;
	CTaskStack *tmps;

	// EZODUS: `task` param is register-backed; clobbered across calls below (same
	// bug as Spawn). Force stack-backed copy before touching CTask fields.
	t = task;

	QueueInit(&t->code_heap->next_mem_blk);
	t->code_heap->last_mergable = NULL;
	if (t->code_heap != t->data_heap)
	{
		QueueInit(&t->data_heap->next_mem_blk);
		t->data_heap->last_mergable = NULL;
	}

	t->addr = t->next_task = t->last_task = t->next_input_filter_task = t->last_input_filter_task = t;

	t->task_num = sys_num_spawned_tasks++;

	t->rflags = RFLAGG_NORMAL;
	t->win_inhibit = WIG_TASK_DEFAULT;

	t->next_child_task = t->last_child_task = (&t->next_child_task)(U8 *) - offset(CTask.next_sibling_task);

	JobCtrlInit(&t->server_ctrl);
	QueueInit(&t->next_cc);
	QueueInit(&t->next_except);
	QueueInit(&t->next_ctrl);
	QueueInit(&t->next_ode);

	t->fpu_mmx = MAllocAligned(sizeof(CFPU), 0x10, Fs);
	MemCopy(t->fpu_mmx, SYS_FIXED_AREA + offset(CSysFixedArea.init_fpu_mmx), sizeof(CFPU));
	// EZODUS: SYS_FIXED_AREA.init_fpu_mmx holds an invalid FXSAVE image on the
	// host (bad MXCSR reserved bits), so a never-yet-run task's first FXRSTOR in
	// _TASK_CONTEXT_RESTORE raises #GP. Force a valid default x87/SSE state:
	// FCW=0x037F, MXCSR=0x1F80, everything else zeroed.
	{
		U8 *fpb = t->fpu_mmx;
		MemSet(fpb, 0, sizeof(CFPU));
		fpb(U16 *)[0]			= 0x037F;		// x87 FCW
		(fpb + 24)(U32 *)[0]	= 0x00001F80;	// MXCSR default
	}

	if (stack_size != -1)
		t->hash_table = HashTableNew(TASK_HASH_TABLE_SIZE, Fs);

	if (stack_size >= 0)
	{
		if (!stack_size)
			stack_size = MEM_DEFAULT_STACK;

		t->stack = tmps = TaskStackNew(stack_size, t);
		t->rsp = &tmps->stack_base(U8 *) + tmps->stack_size;
	}

	t->text_attr 			= WHITE << 4 + DKGRAY;
	t->border_src			= BDS_CONST;
	t->border_attr 			= LTGRAY << 4 + DKGRAY;
	t->title_src 			= TTS_CONST;
	{// EZODUS: TaskInit runs before KEnd sets text.cols/rows.
		I64 cols = text.cols;
		I64 rows = text.rows;
		if (!cols)
			cols = 640 / FONT_WIDTH;
		if (!rows)
			rows = 480 / FONT_HEIGHT;
		t->win_left				= 1;
		t->win_right 			= cols - 2;
		t->win_top 				= rows / 8 + 3;
		t->win_bottom			= rows - 2;
	}

	if (blkdev.home_dir)
	{//Beware System $LK,"TaskInit",A="FF:::/Kernel/KStart64.ZC,TaskInit"$. Maybe ok until $LK,"DiskChange",A="FF:::/Kernel/KMain.ZC,DiskChange"$().
		t->cur_dv	= blkdev.let_to_drive[*blkdev.home_dir - 'A'];
		t->cur_dir	= StrNew(blkdev.home_dir + 2, t);
	}
	else
		t->cur_dir	= StrNew("/Home", Fs);

	Seed(, t);

	return t;
}

CTask *Spawn(U0 (*fp_start_addr)(U8 *data), U8 *data=NULL, U8 *task_name=NULL,
				I64 target_cpu=-1,	// -1 for current CPU. See $LK,"multi-core",A="FI:::/Demo/MultiCore/LoadTest.ZC"$.
				CTask *parent=NULL,	// NULL means sys_task
				I64 stack_size=0,	// 0=default
				I64 flags=1 << JOBf_ADD_TO_QUE)
{//Create task on core running at address.
//Alloc $LK,"CTask",A="MN:CTask"$ structure from code heap so address will be short.
	//Could be alloced off of data heap.
	// EZODUS: `task` MUST be memory-backed (noreg). On host the register HolyC
	// would pick for `task` is clobbered across the many function calls below
	// (TaskInit/HashTableNew/StrCopy...), so a register copy goes stale and later
	// field writes (rip, addr, queue links) land on garbage. Forcing stack storage
	// makes every use reload the correct pointer.
	CTask noreg *task;
	CTask noreg *parent_task;
	CTask noreg *mem_task;
	U8 noreg *task_name_save;
	// EZODUS: capture reg-clobbered params into stack-backed (noreg) locals up
	// front; on host the registers holding these params are trashed across the
	// function calls below, so read them once here and use the copies.
	I64 noreg fp_save, data_save;
	fp_save   = fp_start_addr;
	data_save = data;
	mem_task  = sys_task;
	task_name_save = task_name;
	if (!mem_task || mem_task->task_signature != TASK_SIGNATURE_VAL)
		mem_task = &_boot_task;

	// T/KTASK.HC: -2 = safe spawn from KBCb. EZODUS: single-core host — inline
	// spawn on sys_task (KBCb SetFs + releases kb_host_mtx); no SpawnQueue/AP.
	if (target_cpu == -2)
		target_cpu = -1;
	if (target_cpu >= 0)
		return SpawnQueue(fp_start_addr, data, task_name, target_cpu, parent, stack_size, flags);

	// EZODUS: host has no sys_code_bp/sys_data_bp — each task needs own heap (T Spawn).
	U8 *stk_mem;
	U8 **stack;

	// EZODUS: ZealOS assumes task pointers fit in 32 bits (CTask lives in the low
	// code heap "so address will be short"); several fields/paths truncate task
	// pointers to 32-bit. Allocating from the high data heap yields a >4GB CTask
	// that gets truncated to a bogus low32 value in next_task, so the scheduler
	// restores garbage. Allocate from the code heap (fresh MAP_32BIT pages that do
	// not overlap the loaded image) so the CTask address is genuinely 32-bit.
	// EZODUS: always alloc from sys_task heap, not caller Fs.
	task = CAlloc32(sizeof(CTask), mem_task);
	if (!task)
		throw('OutMem');
	task->task_signature = TASK_SIGNATURE_VAL;
	if (!task_name_save)
		task_name_save = "Unnamed Task";
	if (!parent)
	{
		if (Gs && Gs->executive_task && TaskValidate(Gs->executive_task))
			parent = Gs->executive_task;
		else
			parent = sys_task;
	}
	parent_task = parent;
	task->parent_task = parent_task;
	if (parent_task->gs)
		task->gs = parent_task->gs;
	else
		task->gs = &cpu_structs[0];
	task->code_heap = HeapCtrlInit(, task, 0);
	task->data_heap = HeapCtrlInit(, task, 1);
	if (!stack_size)
		stack_size = 4096;
	TaskInit(task, -1);
	if (parent_task->cur_dv)
	{
		task->cur_dv = parent_task->cur_dv;
		if (parent_task->cur_dir)
		{
			Free(task->cur_dir);
			task->cur_dir = StrNew(parent_task->cur_dir, task);
		}
	}
	EzodusCurDirValidate(task);
	stk_mem = MAlloc(16384, mem_task);
	stack = stk_mem + 16384;
	stack[-1] = data_save(U8 *);
	stack[-2] = &Exit;
	task->rsp = stack - 2;
	task->rip = fp_save;
	task->hash_table = HashTableNew(TASK_HASH_TABLE_SIZE, task);
	// EZODUS: child tasks inherit parent symbols via hash chain (T/KTASK.HC).
	if (task->hash_table && parent_task && parent_task->hash_table)
		task->hash_table->next = parent_task->hash_table;
	else if (!task->hash_table && parent_task && parent_task->hash_table)
		task->hash_table = parent_task->hash_table;
	MemCopy(task->task_name, task_name_save, TASK_NAME_LEN);
	StrCopy(task->task_title, task->task_name);
	task->title_src = TTS_TASK_NAME;

	// EZODUS: scheduler skips task if wake_jiffy>jiffies or SUSPENDED/AWAITING set.
	// These fields end up garbage on host; force-clear so Yield actually runs task.
	task->task_flags = 0;
	task->wake_jiffy = 0;
	// EZODUS: bpt_list (offset 4864) is left non-NULL after MemSet on host — the
	// scheduler's restore re-arm loop then walks garbage CBpts and writes OC_BPT
	// to a nil CBpt.addr. Force-clear the breakpoint list for a clean new task.
	task->bpt_list = NULL;
	// EZODUS: the saved-register context is read verbatim by _TASK_CONTEXT_RESTORE
	// on the task's very first switch-in. Left uninitialized it holds heap garbage
	// (e.g. leftover task-name bytes), so the restore IRETs to a bogus RIP and lands
	// in _TASK_END_NOW. rip/rflags/rsp are set below; zero the rest for a clean entry.
	task->rax = task->rcx = task->rdx = task->rbx = 0;
	task->rbp = task->rsi = task->rdi = 0;
	task->r8 = task->r9 = task->r10 = task->r11 = 0;
	task->r12 = task->r13 = task->r14 = task->r15 = 0;
	// EZODUS: self-ptr addr gets clobbered after TaskInit on host; the scheduler
	// reads CTask.addr first (MOV RSI,CTask.addr[RAX]) so a bad value restores a
	// bogus task. Re-assert it (and rip) last.
	task->addr = task;
	task->rip = fp_save;

	// EZODUS: CLI/POPFD on host pthread SIGSEGVs (same as HashAdd).
	if (Bt(&flags, JOBf_ADD_TO_QUE))
	{
		// EZODUS: TaskQueueInsChild faults on host parent child-list — scheduler queue enough for WinMgr.
		TaskQueueIns(task);
	}

	return task;
}

U0 TaskDerivedValsUpdate(CTask *task=NULL, Bool update_z_buf=TRUE)
{//Those things calculated from other variables.
	if (!task)
		task = Fs;

	while (LBts(&task->task_flags, TASKf_TASK_LOCK))
		PAUSE
	WinDerivedValsUpdate(task);
	if (fp_update_ctrls)
		(*fp_update_ctrls)(task);
	if (update_z_buf && Bt(&task->display_flags, DISPLAYf_SHOW))
		LBts(&sys_semas[SEMA_UPDATE_WIN_Z_BUF], 0);
	LBtr(&task->task_flags, TASKf_TASK_LOCK);
}

I64 ExeCmdLine(CCompCtrl *cc)
{//Terminal JIT-compile-and-execute loop for CCompCtrl.
	I64			 res = 0, type, old_title_src = Fs->title_src;
	U8			*ptr, *ptr2, *ptr3, *machine_code, *old_task_title = StrNew(Fs->task_title);
	F64			 t0;
	CDocEntry	*doc_e;
	CDoc		*doc;

	if (Fs->title_src != TTS_LOCKED_CONST)
		Fs->title_src = TTS_CUR_LEX;
	while (cc->token && (cc->token != '}' || !(cc->flags & CCF_EXE_BLK)) )
	{
		if (Fs->title_src == TTS_CUR_LEX)
		{
			ptr2 = &Fs->task_title;
			ptr3 = ptr2 + STR_LEN - 1;
			if (cc->lex_include_stack->flags & LFSF_DOC)
			{
				doc_e = cc->lex_include_stack->cur_entry;
				doc   = cc->lex_include_stack->doc;
				while (doc_e != doc && ptr2 < ptr3)
				{
					switch (doc_e->type_u8)
					{
						case DOCT_TEXT:
							ptr = doc_e->tag;
							while (*ptr && ptr2 < ptr3)
								*ptr2++ = *ptr++;
							break;

						case DOCT_TAB:
						case DOCT_NEW_LINE:
							*ptr2++ = '.';
							break;
					}
					doc_e = doc_e->next;
				}
				if (ptr2 < ptr3)
					*ptr2 = 0;
			}
			else
				if ((ptr = cc->lex_include_stack->line_start) && *ptr)
					MemCopy(ptr2, ptr, STR_LEN - 1);
		}
		cc->flags &= ~CCF_HAS_MISC_DATA;
		machine_code = LexStatement2Bin(cc, &type);
		if (machine_code != INVALID_PTR)
		{
			if (!(cc->flags & CCF_JUST_LOAD))
			{
				t0 = tS;
				res = Call(machine_code);
				Fs->answer		= res;
				Fs->answer_type	= type;
				Fs->answer_time	= tS - t0;
				Fs->new_answer	= TRUE;
				cc->prompt_line = 0;
			}
			if (!(cc->flags & CCF_HAS_MISC_DATA))
				Free(machine_code);
		}
	}
	if (Fs->title_src != TTS_LOCKED_CONST)
	{
		Fs->title_src = old_title_src;
		StrCopy(Fs->task_title, old_task_title);
	}
	Free(old_task_title);
	if (cc->flags & CCF_JUST_LOAD)
	{
		if (cc->error_count)
			return FALSE;
		else
			return TRUE;
	}
	else
		return res;
}

U0 ServerTaskCont()
{//Act as server task in a loop handling commands.
	I64 old_flags = 0;

	while (TRUE)
	{
		if (JobsHandler(old_flags) && Fs->title_src == TTS_TASK_NAME)
			MemCopy(Fs->task_title, Fs->task_name, TASK_NAME_LEN);
		FlushMessages;
		LBts(&Fs->task_flags, TASKf_IDLE);
		LBts(&Fs->task_flags, TASKf_AWAITING_MESSAGE);
		Yield;
	}
}

U0 UserTaskCont()
{//Terminal key-input-execute loop.
	CCompCtrl	*cc;
	CDoc		*doc;
	Bool		 cont = TRUE;

	do
	{
		cc = CompCtrlNew(, CCF_CMD_LINE | CCF_PROMPT | CCF_QUESTION_HELP, "CmdLine");
		QueueInsert(cc, Fs->last_cc);
		try
		{
			Lex(cc);
			ExeCmdLine(cc);
			cont = Bt(&cc->flags, CCf_PROMPT);
			QueueRemove(cc);
			CompCtrlDel(cc);
		}
		catch
		{
			if ((doc = Fs->put_doc) && doc->doc_signature == DOC_SIGNATURE_VAL)
				DocUnlock(doc);
			PutExcept;
		}
	}
	while (cont);
}

U0 ServerCmdLine(I64 dummy=0)
{
	no_warn dummy;
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT;
	ServerStartUp;
	ServerTaskCont;
}

U0 UserCmdLine(I64 dummy=0)
{//A user task ends-up calling this.
	no_warn dummy;
	Fs->win_inhibit = WIG_USER_TASK_DEFAULT;
	// EZODUS: CallExtStr hash-walk can see NULL child table on host; call direct.
	UserStartUp;
	if (!LBts(&Fs->display_flags, DISPLAYf_SHOW))
		Debug;
	UserTaskCont;
}

CTask *User(U8 *format=NULL, ...)
{//Create user term task.
	U8			*st;
	CTask noreg *task;

	task = Spawn(&UserCmdLine,, "Terminal");

	TaskWait(task);
	if (format)
	{
		st = StrPrintJoin(NULL, format, argc, argv);
		XTalk(task, st);
		Free(st);
	}

	return task;
}

U0 TaskDel(CTask *task)
{//We delay freeing in case lingering pointer to reincarnated.
	CHeapCtrl *ch, *dh;

	if (!task)
		return;
	ch = task->code_heap;
	dh = task->data_heap;
	if (ch && ch->hc_signature == HEAP_CTRL_SIGNATURE_VAL && ch != &ahc)
		HeapCtrlDel(ch);
	if (dh && dh != ch && dh->hc_signature == HEAP_CTRL_SIGNATURE_VAL && dh != &ahd)
		HeapCtrlDel(dh);
	if (task != sys_task)
		Free(task);
}

I64 TaskEnd()
{//Called with irqs off.
	CTask *task = Fs, *tmpt, *tmpt1;

	if (!TaskValidate(task))
	{
		if (TaskValidate(sys_task))
			return sys_task;
		return task;
	}

	// EZODUS: host monolith — minimal task teardown (no child/sibling queues).
	if (_ezodus_host)
	{
		CTask *next;
		CDoc  *doc;

		if (task == sys_task)
			return task;
		next = task->next_task;
		if (sys_focus_task == task)
			sys_focus_task = sys_task;
		if (LBtr(&task->display_flags, DISPLAYf_SHOW))
			LBts(&sys_semas[SEMA_UPDATE_WIN_Z_BUF], 0);
		// Force-unlock — task won't run JobsHandler again; spin can hang OS.
		LBtr(&task->server_ctrl.flags, JOBCf_LOCKED);
		JobQueueDel(&task->server_ctrl.next_waiting);
		JobQueueDel(&task->server_ctrl.next_done);
		LBtr(&task->task_flags, TASKf_TASK_LOCK);
		LBtr(&task->task_flags, TASKf_KILL_TASK);
		LBtr(&task->task_flags, TASKf_AWAITING_MESSAGE);
		LBtr(&task->task_flags, TASKf_CMD_LINE_PROMPT);
		if (doc = task->put_doc)
			if (doc->doc_signature == DOC_SIGNATURE_VAL)
				DocUnlock(doc);
		if (TaskValidate(next) && TaskValidate(task->last_task))
			TaskQueueRemove(task);
		task->task_signature = 0;
		if (TaskValidate(next))
			return next;
		if (TaskValidate(sys_task))
			return sys_task;
		return task;
	}

	if (task == sys_task_being_screen_updated)
	{
		LBts(&task->task_flags, TASKf_KILL_TASK);
		return task->next_task;
	}
	if (task->task_end_cb)
	{
		task->wake_jiffy = 0;
		LBtr(&task->task_flags, TASKf_KILL_TASK);
		TaskResetAwaitingMessage(task);
		Suspend(task, FALSE);
		task->rip = task->task_end_cb;
		task->task_end_cb = NULL;
		return task;
	}
	if (task->parent_task && task->parent_task->popup_task == task)
	{
		task->parent_task->popup_task = NULL;
		Kill(task->parent_task, FALSE);
		return task->parent_task;
	}

	DrivesRelease;
	BlkDevsRelease;
	tmpt1 = (&task->next_child_task)(U8 *) - offset(CTask.next_sibling_task);
	tmpt = tmpt1->next_sibling_task;
	if (tmpt != tmpt1)
	{
		do
		{
			LBts(&tmpt->task_flags, TASKf_KILL_TASK);
			tmpt = tmpt->next_sibling_task;
		}
		while (tmpt != tmpt1);

		return task->next_task;
	}
	if (LBtr(&task->display_flags, DISPLAYf_SHOW))
		LBts(&sys_semas[SEMA_UPDATE_WIN_Z_BUF], 0);

	while (LBts(&task->task_flags, TASKf_TASK_LOCK))
		PAUSE
	while (LBts(&task->server_ctrl.flags, JOBCf_LOCKED))
		PAUSE

	JobQueueDel(&task->server_ctrl.next_waiting);
	JobQueueDel(&task->server_ctrl.next_done);

	if (IsRaw)
		LFBFlush;

	if (sys_focus_task == task)
	{
		if (!Gs->num)
			SingleUser(OFF);
		sys_focus_task = NULL;
		if (fp_set_std_palette)
			(*fp_set_std_palette)();
	}

	//QueueRemove
	task->task_signature(I64) = 0;

	tmpt  =task->next_input_filter_task;
	tmpt1 =task->last_input_filter_task;
	tmpt1->next_input_filter_task = tmpt;
	tmpt->last_input_filter_task  = tmpt1;

	tmpt  = task->next_sibling_task;
	tmpt1 = task->last_sibling_task;
	tmpt1->next_sibling_task = tmpt;
	tmpt->last_sibling_task  = tmpt1;

	tmpt = task->next_task; //save to return
	TaskQueueRemove(task);

	LBtr(&task->server_ctrl.flags, JOBCf_LOCKED);
	LBtr(&task->task_flags, TASKf_TASK_LOCK);

	// EZODUS: CTaskDying defer-free overlays CTask.addr — free now while still valid.
	if (task != sys_task)
		TaskDel(task);

	return tmpt;
}

U0 TaskKillDying()
{//EZODUS: host monolith — skip dying-task queue until real MP executive.
}
