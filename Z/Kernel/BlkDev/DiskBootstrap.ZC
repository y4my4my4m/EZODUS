//──────────────────────────────────────────────────────────────────────────
// EZODUS: bodies for KExterns.ZC externs whose ring-0 homes (DiskDrive,
// DiskFileB, MultiProc) are not in this build. An extern that is never
// defined compiles into a call to an unresolved address.

U8 blkdev_text_attr[BDT_TYPES_NUM]	= {BLACK, LTCYAN, WHITE, LTGREEN, LTRED, LTBLUE};
U8 drv_text_attr[3]					= {BLACK, BLUE, RED};

public I64 Letter2BlkDevType(U8 drv_let=0)
{//All host VFS drives look like hard drives.
	no_warn drv_let;
	return BDT_ATA;
}

public U8 DriveTextAttrGet(U8 drv_let=0)
{//Get color of drive.
	drv_let = Letter2Letter(drv_let);
	if ('A' <= drv_let <= 'Z')
		//EZODUS: host drive Z: gets the same colors as the ZealOS C: boot drive.
		return blkdev_text_attr[Letter2BlkDevType(drv_let)] << 4 | drv_text_attr['C' % sizeof(drv_text_attr)];
	else
		return BLACK << 4 | WHITE;
}

public U0 BootHDIns(U8 drv_let=0)
{//Stock recompiles the kernel and patches the boot loader; Ezodus has neither.
	no_warn drv_let;
	"Ezodus runs in ring-3; there is no boot sector or kernel image to install.\n"
	"Rebuild the host image instead:\n"
	"    ./ezodus -c -f HCRT_BOOTSTRAP.BIN BuildHCRT.ZC\n"
	"Display resolution lives in ::/EzodusRes.HH.\n";
}

