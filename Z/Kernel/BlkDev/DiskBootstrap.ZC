public CBlkDev *DriveIsWritable(U8 drv_let=0, Bool except=FALSE)
{//Host VFS drives are always writable.
	CDrive *drive = Letter2Drive(drv_let, except);

	if (drive && drive->drive_signature == DRIVE_SIGNATURE_VAL)
		return drive->bd;
	return NULL;
}

public Bool Copy(U8 *src_files_find_mask, U8 *dst_files_find_mask=".")
{//Copy a single file (host VFS; masks not supported).
	U8	*buf, *src_abs, *dst_abs, *name, *dst2;
	I64	 size;
	Bool res = FALSE;

	src_abs = FileNameAbs(src_files_find_mask);
	dst_abs = FileNameAbs(dst_files_find_mask);
	if (src_abs && dst_abs && (buf = FileRead(src_abs, &size)))
	{
		if (IsDir(dst_abs))
		{
			name = StrLastOcc(src_abs, "/");
			if (!name)
				name = src_abs;
			dst2 = MStrPrint("%s/%s", dst_abs, name + 1);
			res = FileWrite(dst2, buf, size) == size;
			Free(dst2);
		}
		else
			res = FileWrite(dst_abs, buf, size) == size;
		Free(buf);
	}
	Free(src_abs);
	Free(dst_abs);
	return res;
}

public Bool Move(U8 *f1, U8 *f2)
{
	if (!Copy(f1, f2))
		return FALSE;
	return Del(f1,,, FALSE) > 0;
}

extern CDirEntry *FilesFind(U8 *files_find_mask, I64 fuf_flags=0);
extern U0 DirTreeDel(CDirEntry *tmpde);

public I64 CopyTree(U8 *src_files_find_mask, U8 *dst_files_find_mask, Bool no_mask=TRUE)
{//Recursive copy (host VFS).
	CDirEntry	*tmpde, *tmpde1;
	U8			*mask, *dst2;
	I64			 count = 0;

	no_warn no_mask;
	DirMake(dst_files_find_mask);
	mask = MStrPrint("%s/*", src_files_find_mask);
	tmpde1 = tmpde = FilesFind(mask);
	while (tmpde)
	{
		if (!(tmpde->name[0] == '.' &&
				(!tmpde->name[1] || tmpde->name[1] == '.' && !tmpde->name[2])))
		{
			dst2 = MStrPrint("%s/%s", dst_files_find_mask, tmpde->name);
			if (tmpde->attr & RS_ATTR_DIR)
				count += CopyTree(tmpde->full_name, dst2);
			else if (Copy(tmpde->full_name, dst2))
				count++;
			Free(dst2);
		}
		tmpde = tmpde->next;
	}
	DirTreeDel(tmpde1);
	Free(mask);
	return count;
}

public I64 DelTree(U8 *files_find_mask, U8 *fu_flags=NULL)
{//Host VFsDel already deletes recursively.
	no_warn fu_flags;
	return Del(files_find_mask,, TRUE, FALSE);
}

